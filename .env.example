# Visitor counter (src/lib/server/visitors.js)
#
# Not set locally: falls back to a real SQLite file at data/visitors.db, so
# `npm run dev` works with zero setup.
#
# Set both of these as Vercel project env vars for production, so counts
# persist across deploys/cold starts instead of resetting:
#   1. Create a free database:      turso db create webmold-visitors
#   2. Get the connection URL:      turso db show webmold-visitors --url
#   3. Create an auth token:        turso db tokens create webmold-visitors
# (or do all three from the Turso dashboard: https://turso.tech/app)

DATABASE_URL=
DATABASE_AUTH_TOKEN=